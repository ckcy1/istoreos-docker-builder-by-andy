#!/bin/sh
# ============================================================
# uci-defaults 脚本：首次启动时自动执行一次
# 作用：动态检测容器内网卡名，写入正确的网络配置
# 执行时机：iStoreOS 首次启动时
# 执行后：本脚本自动从 /etc/uci-defaults 删除
# ============================================================

# 初始化网卡变量
IFACE=""

# 遍历 /sys/class/net/ 下所有网卡
for dev in /sys/class/net/*; do
    # 提取网卡名（目录名）
    name=$(basename "$dev")
    # 跳过 lo 和 Docker 虚拟接口
    case "$name" in
        lo|docker*|veth*|br-*) continue ;;
    esac
    # 找到第一个可用网卡，赋值并跳出循环
    IFACE="$name"
    break
done

# 如果没找到网卡，回退为 eth0
[ -z "$IFACE" ] && IFACE="eth0"

echo "[uci-defaults] 检测到网卡: $IFACE"

# 使用 uci batch 批量写入配置
uci -q batch <<EOF
# 删除可能存在的 wan 接口（避免与 lan 冲突）
delete network.wan
delete network.wan6
# 设置 br-lan 桥接设备，将检测到的网卡加入
set network.@device[0].name='br-lan'
set network.@device[0].type='bridge'
set network.@device[0].ports='$IFACE'
# 设置 lan 接口使用 DHCP
set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='dhcp'
EOF

# 提交配置变更
uci commit network

# 重启网络服务，让配置立即生效
/etc/init.d/network restart

exit 0