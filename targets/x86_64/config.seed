# ============================================================
# ImageBuilder 的额外配置种子
# 会被追加到 ImageBuilder 的 .config 中
# ============================================================

# 关键：启用 rootfs.tar.gz 输出
# 没有这一行，make image 不会生成 rootfs.tar.gz
CONFIG_TARGET_ROOTFS_TARGZ=y

# 同时输出 .img.gz（用于虚拟机部署）
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 内核分区大小 32MB
CONFIG_TARGET_KERNEL_PARTSIZE=32

# rootfs 分区大小 1024MB
CONFIG_TARGET_ROOTFS_PARTSIZE=1024